{
  "name": "openevolve-evaluator-generator",
  "productName": "OpenEvolve Analytics Console",
  "version": "1.0.0",
  "description": "AI-powered evaluator.py generator for OpenEvolve optimization problems",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "desktop": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "openevolve",
    "evolutionary-algorithms",
    "optimization",
    "ai",
    "claude",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.9",
    "@google/generative-ai": "^0.3.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.0.2"
  },
  "build": {
    "appId": "com.kg.openevolveanalytics",
    "productName": "OpenEvolve Analytics Console",
    "files": [
      "**/*",
      "!dist{,/**}",
      "!build{,/**}",
      "!node_modules/.cache{,/**}"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
